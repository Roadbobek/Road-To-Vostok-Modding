# Ignore everything in the root directory by default
/*

# DO NOT ignore these specific files/folders (The '!' means 'Allow')
!.gitignore
!.gitattributes
!mods-unpacked/
!Roadbobek/

# Even inside the mods folder, ignore these if they exist

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
